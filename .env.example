# ---- Server (server/.env) ----
PORT=4000
# En producción: dominio del client para CORS (separado por comas si hay varios)
# CORS_ORIGIN=https://norte-aventura.vercel.app
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
BUSINESS_WHATSAPP=5493874039502

# ---- Mercado Pago ----
MP_ACCESS_TOKEN=APP_USR-xxxx          # access token de producción (o TEST- para probar)
# MP_WEBHOOK_SECRET=                  # opcional: firma del webhook (Mercado Pago → Tu integración)
CLIENT_URL=https://tu-sitio.vercel.app  # a dónde vuelve el cliente tras pagar
PUBLIC_URL=https://tu-api.vercel.app    # URL pública de esta API (para el webhook de MP)

# ---- Backoffice (/admin) ----
ADMIN_PASSWORD=una-clave-fuerte
ADMIN_SECRET=otro-secreto-para-firmar-jwt

# ---- Client (client/.env) ----
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# En producción: URL del proyecto server en Vercel (sin barra final)
# VITE_API_URL=https://norte-aventura-api.vercel.app
